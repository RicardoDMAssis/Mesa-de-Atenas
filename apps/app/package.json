{
  "name": "@estudarella/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "e2e": "playwright test",
    "android:sync": "vite build && cap sync android",
    "android:open": "cap open android",
    "build:plugins": "pnpm --dir ../.. --filter \"./plugins/*\" --filter \"!@estudarella/plugin-template\" build",
    "predev": "pnpm build:plugins",
    "prebuild": "pnpm build:plugins"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/local-notifications": "^8.3.1",
    "@estudarella/core": "workspace:*",
    "@estudarella/db": "workspace:*",
    "@estudarella/plugin-api": "workspace:*",
    "@tiptap/extension-mention": "^3.34.0",
    "@tiptap/extension-placeholder": "^3.34.0",
    "@tiptap/pm": "^3.34.0",
    "@tiptap/react": "^3.34.0",
    "@tiptap/starter-kit": "^3.34.0",
    "@tiptap/suggestion": "^3.34.0",
    "drizzle-orm": "^0.45.4",
    "fflate": "^0.8.3",
    "graphology": "^0.26.0",
    "graphology-layout-forceatlas2": "^0.10.1",
    "lucide-react": "^1.73.0",
    "open-bot-avatar": "0.2.1",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "sigma": "^4.0.6",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
