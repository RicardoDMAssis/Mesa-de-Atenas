{
  "name": "estudarella",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "scripts": {
    "dev": "pnpm --filter @estudarella/app dev",
    "build": "pnpm --filter @estudarella/app build",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @estudarella/app e2e",
    "lint": "biome check .",
    "format": "biome check --write .",
    "db:generate": "pnpm --filter @estudarella/db generate"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.8",
    "typescript": "^7.0.2"
  }
}
